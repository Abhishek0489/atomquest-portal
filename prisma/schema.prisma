// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum UoMType {
  NUMERIC_MIN   // Higher is better (e.g. Sales Revenue)
  NUMERIC_MAX   // Lower is better (e.g. TAT, Cost)
  TIMELINE      // Date-based completion
  ZERO          // Zero = success (e.g. Safety incidents)
}

enum GoalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  LOCKED
}

enum ProgressStatus {
  NOT_STARTED
  ON_TRACK
  COMPLETED
}

enum CheckinPeriod {
  Q1
  Q2
  Q3
  Q4_ANNUAL
}

enum CyclePhase {
  GOAL_SETTING
  Q1_CHECKIN
  Q2_CHECKIN
  Q3_CHECKIN
  Q4_ANNUAL
  CLOSED
}

// ─── MODELS ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String    // hashed
  role          Role
  department    String?
  managerId     String?
  manager       User?     @relation("Reports", fields: [managerId], references: [id])
  reportees     User[]    @relation("Reports")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  goals                 Goal[]         @relation("OwnerGoals")
  sharedGoalRecipients  SharedGoalRecipient[]
  checkinsGiven         Checkin[]      @relation("ManagerCheckins")
  auditLogs             AuditLog[]
}

model Cycle {
  id          String      @id @default(cuid())
  year        Int
  phase       CyclePhase
  openDate    DateTime
  closeDate   DateTime
  isActive    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  goals       Goal[]
}

model Goal {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation("OwnerGoals", fields: [ownerId], references: [id])
  cycleId       String
  cycle         Cycle         @relation(fields: [cycleId], references: [id])

  thrustArea    String
  title         String
  description   String?
  uomType       UoMType
  target        Float
  targetDate    DateTime?     // for TIMELINE uom
  weightage     Float         // 10–100, sum across all goals = 100

  status        GoalStatus    @default(DRAFT)
  isShared      Boolean       @default(false)
  sharedFromId  String?       // if this is a copy from a shared goal

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  versions      GoalVersion[]
  checkins      Checkin[]
  dependencies  GoalDependency[]  @relation("DependentGoal")
  dependents    GoalDependency[]  @relation("RequiredGoal")
  sharedRecipients SharedGoalRecipient[]
  auditLogs     AuditLog[]
}

model GoalVersion {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id])
  changedById String
  changedAt   DateTime  @default(now())
  snapshot    Json      // full goal object at this point in time
  changeNote  String?   // e.g. "Manager edited target during approval"
}

model GoalDependency {
  id              String  @id @default(cuid())
  dependentGoalId String  // this goal depends on...
  requiredGoalId  String  // ...this goal
  dependentGoal   Goal    @relation("DependentGoal", fields: [dependentGoalId], references: [id])
  requiredGoal    Goal    @relation("RequiredGoal", fields: [requiredGoalId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([dependentGoalId, requiredGoalId])
}

model SharedGoalRecipient {
  id            String  @id @default(cuid())
  goalId        String  // the original shared goal
  goal          Goal    @relation(fields: [goalId], references: [id])
  recipientId   String
  recipient     User    @relation(fields: [recipientId], references: [id])
  weightage     Float   // recipient can adjust this only
  createdAt     DateTime @default(now())
}

model Checkin {
  id              String        @id @default(cuid())
  goalId          String
  goal            Goal          @relation(fields: [goalId], references: [id])
  period          CheckinPeriod
  actualValue     Float?
  actualDate      DateTime?     // for TIMELINE uom
  progressStatus  ProgressStatus @default(NOT_STARTED)
  computedScore   Float?        // auto-calculated, see scoring logic
  managerComment  String?
  managerId       String?
  manager         User?         @relation("ManagerCheckins", fields: [managerId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([goalId, period])
}

model AuditLog {
  id          String    @id @default(cuid())
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String    // e.g. "GOAL_APPROVED", "TARGET_EDITED", "GOAL_UNLOCKED"
  details     Json?     // before/after values
  timestamp   DateTime  @default(now())
}
