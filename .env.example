# Copy to .env (local) — set the same keys in Vercel → Project → Settings → Environment Variables
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Use Neon's *pooled* connection string on Vercel (host contains -pooler)
# Local .env may use quotes; on Vercel paste values WITHOUT quotes around them.
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=same-value-as-AUTH_SECRET
NEXTAUTH_URL=http://localhost:3000
# Production (Vercel): exact origin only, e.g. https://atomquest-portal.vercel.app
# Wrong (crashes middleware): quotes, localhost, paths, or missing https://
# Optional on Vercel: omit NEXTAUTH_URL and rely on trustHost + VERCEL auto-detect
